{
  "name": "cabina",
  "productName": "Cabina",
  "version": "0.1.0",
  "description": "Cabina como app de escritorio: la misma web, sin los límites del navegador",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mac": "electron-builder --mac",
    "win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.cabina.app",
    "productName": "Cabina",
    "files": [
      "main.js",
      "updater.js",
      "control.js",
      "firma.js",
      "web-segura.js",
      "preload.js",
      "control-preload.js",
      "picker.html",
      "picker-preload.js",
      "offline.html",
      "control.html"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Cabina-App-Mac.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cabina usa el micro para que tus colegas te oigan en la sala.",
        "NSCameraUsageDescription": "Cabina usa la cámara para que tus colegas te vean en la sala."
      },
      "extraResources": [
        {
          "from": "helper/build/cabina-control",
          "to": "cabina-control"
        }
      ]
    },
    "dmg": {
      "title": "Cabina",
      "background": "build/background.tiff",
      "window": {
        "width": 600,
        "height": 400
      },
      "iconSize": 112,
      "contents": [
        {
          "x": 160,
          "y": 215,
          "type": "file"
        },
        {
          "x": 440,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Cabina-App-Windows.${ext}",
      "icon": "build/icon-win.png",
      "extraResources": [
        {
          "from": "helper/build/cabina-control.exe",
          "to": "cabina-control.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Cabina"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/1stpleiss/cabina/releases/download/app/"
      }
    ],
    "copyright": "© 2026 Pleiss"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "author": {
    "name": "Pleiss"
  }
}
